# Generate loader-info.c: the offset of the loader's `pokedata_workaround` symbol from
# the loader's entry point.
#
# Mirrors the GNUmakefile rule
#     loader/loader-info.c: loader/loader
#             readelf -s $< | awk -f loader/loader-info.awk > $@
# but does the symbol arithmetic in CMake instead of awk. The upstream awk script uses
# `strtonum`, a **gawk** extension: Debian's default awk is mawk, which lacks it, so
# the upstream pipeline fails here with "function strtonum never defined".
#
# Only used on arm64 (HAS_POKEDATA_WORKAROUND); tracee/mem.c references
# `offset_to_pokedata_workaround`, which this file defines.
#
# Invoked with -DREADELF=... -DLOADER=... -DOUT=...
#
# **The values arrive with literal double-quotes.** ninja does no shell quoting: it
# passes `-DLOADER="/abs/path"` as a single argv entry with the quotes included, so
# `${LOADER}` is `"/abs/path"` and every filesystem test on it fails. A shell
# invocation strips the quotes, which is why this worked by hand and not under ninja.
# Strip them before use.

foreach(_var READELF LOADER OUT)
    string(REPLACE "\"" "" ${_var} "${${_var}}")
endforeach()

if(NOT READELF OR NOT LOADER OR NOT OUT)
    message(FATAL_ERROR "gen-loader-info: READELF, LOADER and OUT are required")
endif()

if(NOT EXISTS "${LOADER}")
    message(FATAL_ERROR "gen-loader-info: loader does not exist: ${LOADER}")
endif()

execute_process(
    COMMAND "${READELF}" -s "${LOADER}"
    OUTPUT_VARIABLE _syms
    ERROR_VARIABLE _err
    RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "gen-loader-info: readelf rc=${_rc} on ${LOADER}: ${_err}")
endif()

# Each line looks like:
#      9: 0000005400000000  1880 FUNC    GLOBAL DEFAULT     1 _start
# Field 2 is the value (hex, no 0x prefix); the name is the last field.
string(REGEX MATCH "[0-9]+:[ \t]+([0-9a-fA-F]+)[ \t]+[0-9]+[ \t]+[A-Z]+[ \t]+[A-Z]+[ \t]+[A-Z0-9]+[ \t]+[0-9]+[ \t]+pokedata_workaround"
       _pd_match "${_syms}")
set(_pd_hex "${CMAKE_MATCH_1}")
string(REGEX MATCH "[0-9]+:[ \t]+([0-9a-fA-F]+)[ \t]+[0-9]+[ \t]+FUNC[ \t]+[A-Z]+[ \t]+[A-Z]+[ \t]+[0-9]+[ \t]+_start"
       _st_match "${_syms}")
set(_st_hex "${CMAKE_MATCH_1}")

if(NOT _pd_hex OR NOT _st_hex)
    message(FATAL_ERROR "gen-loader-info: could not find _start/pokedata_workaround in ${LOADER}")
endif()

math(EXPR _offset "0x${_pd_hex} - 0x${_st_hex}")

file(WRITE "${OUT}"
"/* Generated by cmake/gen-loader-info.cmake — do not edit, and do not commit. */
#include <unistd.h>
const ssize_t offset_to_pokedata_workaround = ${_offset};
")
message(STATUS "proot: pokedata offset ${_offset} (pokedata=0x${_pd_hex}, start=0x${_st_hex})")
