<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Declared here because this module reads it: NetworkApi calls
         ConnectivityManager.getActiveNetwork, and a library must declare the
         permission its own code needs. The app module repeats it for the merged
         manifest's sake. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <service
            android:name="com.vyzorix.service.VyzorixForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_management_agent" />
        </service>

        <receiver
            android:name="com.vyzorix.service.DeviceBootHook"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The device-admin receiver. Declaring it is what makes the app eligible to
             be added as a device administrator from Settings > Security > Device admin
             apps; the operator grants the role, the app cannot take it. The
             BIND_DEVICE_ADMIN permission is the system's guard, and only the system
             holds it, so the receiver is never directly callable by another app.

             The policy list in res/xml/device_admin.xml is what the activation screen
             shows and what the app may then use. This is an *admin*, not an owner:
             admin powers are per-device actions, owner powers are organisation policy,
             and only the latter can be set at provisioning time. -->
        <receiver
            android:name="com.vyzorix.service.VyzorixDeviceAdminReceiver"
            android:exported="true"
            android:label="Vyzorix"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
