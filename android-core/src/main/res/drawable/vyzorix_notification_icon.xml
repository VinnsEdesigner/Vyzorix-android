<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification's small icon: a terminal window with a prompt chevron and a
  cursor, the glyph for "a command-line agent is running".

  Monochrome on purpose. A notification small icon is masked to a single colour by
  the system (the alpha channel is the shape), so a coloured or detailed icon is
  flattened anyway. The previous icon was `stat_sys_download_done` — a download
  arrow — which said "a file finished downloading", the opposite of what this
  notification means and the wrong affordance for a persistent service.

  Stroke-based so it reads at the ~18dp the status bar draws it. The paths are
  fill-free (transparent fill, white stroke) so the shape is the outline, which is
  what survives the mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The terminal window: a rounded rectangle. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4,4 L20,4 A2,2 0 0 1 22,6 L22,18 A2,2 0 0 1 20,20 L4,20 A2,2 0 0 1 2,18 L2,6 A2,2 0 0 1 4,4 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />

    <!-- The prompt: a ">" chevron. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M6.5,9.5 L9.5,12 L6.5,14.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />

    <!-- The cursor: a baseline "_". -->
    <path
        android:fillColor="#00000000"
        android:pathData="M11.5,14.5 L16,14.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
</vector>
