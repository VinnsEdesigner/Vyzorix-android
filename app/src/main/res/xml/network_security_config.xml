<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy.

  The default is the platform default: cleartext HTTP is refused, TLS required.
  That is correct for the fleet, which talks to the server over HTTPS.

  The exception is the emulator's host loopback (10.0.2.2) and localhost, which
  exist only for local development against a server on the developer's machine
  running over plain HTTP. A release build talks to a real HTTPS endpoint and does
  not need them, so they are scoped to a domain list rather than switching
  cleartext on globally — a global opt-in would also permit cleartext to the real
  server, which is exactly the downgrade this policy exists to prevent.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, as seen from inside the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A device on the same machine, or adb reverse. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
