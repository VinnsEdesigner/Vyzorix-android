<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keeps the container alive; the container's child processes are not phantom
         processes precisely because they belong to this service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ for the service's `specialUse` foreground type. The
         type is evaluated by the platform, not against targetSdk, so the permission
         is needed even though this app pins targetSdk 28. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shared storage, for the container's view of /sdcard.
         Scoped storage gates the shared tree on holding this permission even at
         targetSdk 28; without it the tree is read-only on API 29+ and Android/data
         is denied. Declared uncapped so the grant holds across every supported API
         level. WRITE_EXTERNAL_STORAGE is a no-op from API 30 on, but declaring it
         keeps the API 26-29 range working.
         See doc/DEVICE_FILESYSTEM_ACCESS.md. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Self-update. Required to hand a downloaded APK to the package installer;
         the user still confirms the install. See AndroidApkInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ======================================================================
         Permissions the bridge APIs need. Each is declared here because the API
         that calls the platform cannot answer without it: an undeclared
         permission is not granted, so the call throws SecurityException rather
         than returning a fact. A library module declares what its own code
         needs; this list is the app-side half of that rule.
         ====================================================================== -->

    <!-- Adapter state. ACCESS_WIFI_STATE, BLUETOOTH and NFC are install-time
         (normal) permissions, so there is no dialog, but an undeclared normal
         permission is still not granted. WifiStateApi, BluetoothStateApi and
         NfcStateApi each read one. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- BluetoothAdapter.isEnabled() needs BLUETOOTH_CONNECT from API 31, where the
         old BLUETOOTH permission was split into CONNECT/SCAN/ADVERTISE. A
         dangerous permission, so it is requested at runtime; without it
         BluetoothStateApi throws on a 31+ device even though it holds BLUETOOTH.
         Declared with maxSdkVersion unset because both are needed across the range:
         BLUETOOTH below 31, BLUETOOTH_CONNECT from 31. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- LocationApi reads the last known fix, which needs a location permission.
         Fine rather than coarse: the API reports a position, and coarse would be
         a silently worse answer. Dangerous, so the dialog is requested at runtime
         before the API is first used. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- CallCapabilityApi asks TelecomManager whether the device can place calls;
         reading the default dialer needs CALL_PHONE. Dangerous. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- CameraListApi enumerates camera ids (no permission needed for the
         listing), but the capability question — "can this device take a photo" —
         is answered through the camera service, which needs CAMERA. Dangerous. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- PhoneStateApi reads the phone type and SIM state, which needs
         READ_PHONE_STATE. Dangerous. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- READ_BASIC_PHONE_STATE (API 33+) is the non-dangerous half of
         READ_PHONE_STATE: "read only access to phone state ... cellular network
         type, software version", protection level `normal`, so no dialog. The
         registry gates `phone_state` on this one, because the API mostly reports
         non-sensitive facts (operator name, SIM state) and gating it on the
         dangerous permission would make the whole API unusable for a user who
         declines the dialog. The one method that genuinely needs the dangerous
         grant — `isNetworkRoaming` — degrades to "unknown" in the handler.
         Declared alongside READ_PHONE_STATE so a build that is granted the stronger
         permission keeps every field. -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <!-- The SMS pair. SEND_SMS is what SmsManager needs; RECEIVE_SMS is separate
         on every API level and is what SmsReceivedApi observes, so an app that
         can send cannot necessarily receive. Both dangerous. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- StorageAllFilesApi reports and requests all-files access. A Play-restricted
         permission, granted only through a Settings screen rather than a dialog, so
         the app asks for the screen rather than the permission. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- LogcatApi reads the log buffer, which needs READ_LOGS. Signature-level:
         not grantable to a sideloaded build by a runtime dialog, so the API
         reports the refusal rather than pretending the log is empty.

         Declared anyway, and lint's ProtectedPermissions is suppressed deliberately:
         the declaration is what lets a *privileged* build (a device-owner or
         platform-signed deployment) hold it, while the ordinary build fails closed
         at the router. Removing it would make the API silently unusable everywhere
         rather than usable where the grant exists. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ======================================================================
         Hardware the permissions above would otherwise imply as *required*.

         Google Play infers required hardware from a declared permission: CAMERA
         implies android.hardware.camera, CALL_PHONE and the SMS pair imply
         android.hardware.telephony. Without an explicit override the listing would
         exclude every device without those — tablets, Wi-Fi-only phones,
         Chromebooks — for permissions the agent holds so it can *answer questions*
         about the hardware, not because it needs it.

         All three are `required="false"`: the APIs report "no camera" or "no
         telephony" as a fact, which is the behaviour the handlers are written for.
         ====================================================================== -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- Package visibility, declared in full. `QUERY_ALL_PACKAGES` is the
         declaration form that makes `getInstalledPackages` return every installed
         package rather than the filtered subset: from API 30 the platform narrows
         the list to what the app declares, and a device-management agent whose job
         is to report what is installed cannot work on a subset — a partial count is
         silently wrong, not merely incomplete.

         Protection level is `normal`, so it is granted at install with no dialog.
         Play restricts it to specific use cases, but this app is sideload-only by
         design (targetSdk 28, see README), so there is no policy review to pass; on
         F-Droid and direct APK the declaration simply takes effect.

         The `<queries>` block below is kept as well: it is what makes the *intent*
         resolutions work (a launcher query, a VIEW https query) independently of the
         broad package list, and it is the fallback if this permission is ever
         stripped by a store or a fork. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name="com.vyzorix.agent.VyzorixApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="Vyzorix"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <!-- The setup hop: requests permissions, then opens the Accessibility
             settings screen. It is NOT the launcher entry — see the alias below. -->
        <activity
            android:name="com.vyzorix.agent.LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Vyzorix"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The launcher entry, as an alias so it can be switched off.

             It is visible only until accessibility is granted: the accessibility
             service disables this component (see VyzorixAccessibilityService), which
             removes the icon from the app drawer AND greys the app-info "Open"
             button, because Android offers "Open" only when an enabled launcher
             activity exists. Enabling accessibility therefore makes the app fully
             invisible, and disabling it brings the icon back. -->
        <activity-alias
            android:name="com.vyzorix.agent.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:label="Vyzorix"
            android:targetActivity="com.vyzorix.agent.LaunchActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The enable-gate. The operator turns this on in Settings > Accessibility;
             that act arms the agent and hides the launcher icon above. The service
             observes nothing (see VyzorixAccessibilityService). -->
        <service
            android:name="com.vyzorix.agent.VyzorixAccessibilityService"
            android:exported="true"
            android:label="Vyzorix"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vyzorix_accessibility_service" />
        </service>

        <!-- Exposes the downloaded APK to the package installer, which runs in
             another process and cannot read the app's private storage. The authority
             suffix must match AndroidApkInstaller.AUTHORITY_SUFFIX. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
