<?xml version="1.0" encoding="utf-8"?>
<!--
  The `sideload` flavor's manifest overlay.

  Google Play Protect blocks this app on install with a hard, non-overridable
  verdict — "this app is blocked from installing, it's malicious and could cause a
  financial fraud" — because the full permission set matches the SMS-fraud /
  banking-trojan signature: it can read SMS, read the log buffer, install APKs and
  run an accessibility service. The verdict comes from Google's cloud, so disabling
  the on-device Play Protect toggle does not lift it.

  This overlay removes the permissions that make up that signature. Each one is
  removed deliberately, with what it costs:

    REQUEST_INSTALL_PACKAGES  — the heaviest flag (a "dropper"). Cost: in-app OTA
                                self-update. The user updates by installing the new
                                APK by hand; the /v1/check-update endpoint still
                                reports that one is available.
    SEND_SMS, RECEIVE_SMS     — the fraud marker. Cost: the `sms_capability` and
                                `sms_received` bridge APIs.
    READ_LOGS                 — credential-scraping marker, and useless anyway: it is
                                signature-level, so a normal app is never granted it
                                and `logcat` already fails closed. Cost: nothing that
                                worked.
    MANAGE_EXTERNAL_STORAGE   — exfiltration marker. Cost: the `storage_all_files`
                                API reports "not held" (it already only reports state).
    QUERY_ALL_PACKAGES        — enumeration marker. Cost: `installed_apps` sees only
                                the filtered package list the platform allows.
    CALL_PHONE                — reads the default dialer. Cost: `call_capability`
                                reports the dialer is unavailable.

  Every removed permission's API fails closed rather than crashing: ApiRouter.dispatch
  catches Throwable and each handler catches SecurityException, so a call returns a
  bridge error instead of taking the service down.

  The `full` flavor keeps all of them, for internal builds where Play Protect is not
  in the path (adb install bypasses it entirely).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Self-update. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- SMS pair: the fraud-trojan marker. -->
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:node="remove" />

    <!-- Log buffer (signature-level; never granted to a normal app anyway). -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:node="remove" />

    <!-- All-files access. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Full package visibility. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" />

    <!-- Default-dialer read. -->
    <uses-permission
        android:name="android.permission.CALL_PHONE"
        tools:node="remove" />

</manifest>
